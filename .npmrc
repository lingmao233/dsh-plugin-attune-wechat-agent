# This is an out-of-tree DSH bundle: its peer dependencies (cordis,
# dsh-client-runtime, dsh-client-ui-slots, dsh-host-webserver, react) are
# supplied by the running DeepSeek Harness installation, not by this package.
# Only `dependencies` need a local install when the bundle is linked from a
# checkout (`dsh plugin add <path>` uses `link:` and does not install the
# linked package's dependencies).
auto-install-peers=false
