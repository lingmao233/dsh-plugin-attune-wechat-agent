{
  "name": "dsh-plugin-attune",
  "version": "0.8.4",
  "description": "Attune — 微信 AI Agent / 微信 AI / WeChat agent / WeChat AI for DeepSeek Harness: emotional memory, moods, relationships, voice. Search 微信agent / 微信ai / wechatagent / wechatai.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/client.js",
    "lib/remote.mjs",
    "lib/setup.mjs",
    "lib/tarball.mjs",
    "build/pack-source.mjs",
    "assets/",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:source": "node build/pack-source.mjs",
    "check": "node --check index.mjs && node --check lib/client.js && node --check lib/remote.mjs && node --check lib/setup.mjs && node --check lib/tarball.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "attune",
    "wechat",
    "wechat-agent",
    "wechat-ai",
    "wechat agent",
    "wechat ai",
    "wechatagent",
    "wechatai",
    "wechat-bot",
    "微信",
    "微信agent",
    "微信ai",
    "微信机器人",
    "微信群助手",
    "ai-companion",
    "emotional-ai",
    "one-click-deploy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lingmao233/dsh-plugin-attune-wechat-agent.git"
  },
  "homepage": "https://github.com/lingmao233/dsh-plugin-attune-wechat-agent",
  "bugs": {
    "url": "https://github.com/lingmao233/dsh-plugin-attune-wechat-agent/issues"
  },
  "author": "lingmao233",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "ssh2": "1.17.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "license": "MIT"
}
